# ============================================================
# Autonomous PKMS — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DSN=postgresql+asyncpg://pkms:changeme@localhost:5432/pkms
# For Alembic sync migrations only:
POSTGRES_SYNC_DSN=postgresql+psycopg2://pkms:changeme@localhost:5432/pkms
POSTGRES_POOL_SIZE=5
POSTGRES_POOL_OVERFLOW=2

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB ----
CHROMA_PATH=./data/chroma          # local persistent dir on app host

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
# Set true when APOC + GDS plugins are installed (self-hosted Community)
PKMS_NEO4J_HAS_GDS=true

# ---- Embeddings ----
PKMS_EMBED_DEVICE=cpu              # cpu | cuda
PKMS_EMBED_BATCH=32
PKMS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- OCR ----
PKMS_OCR_ENGINE=pytesseract        # pytesseract | easyocr

# ---- File storage ----
PKMS_DATA_DIR=./data/documents     # raw uploaded files root

# ---- JWT ----
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60

# ---- Outbox ----
OUTBOX_SWEEP_SECONDS=2
OUTBOX_BATCH_SIZE=100

# ---- Classification ----
REPLAY_MAX=2000
REPLAY_MIX=64

# ---- KG Maintenance ----
KG_MAINTAIN_SECONDS=900
KG_BREAK_CYCLES=false

# ---- Analytics ----
ANALYTICS_SECONDS=1800
ANALYTICS_MIN_COOC=2

# ---- Dedup ----
JACCARD_THRESHOLD=0.85
SHINGLE_K=3
NUM_PERM=128
DEDUP_BANDS=16

# ---- Upload limits ----
MAX_UPLOAD_MB=50

# ---- Celery ----
CELERY_WORKER_CONCURRENCY=4
CELERY_CLASSIFIER_CONCURRENCY=1   # single-worker queue for classifier state
